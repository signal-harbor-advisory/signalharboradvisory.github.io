---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import { SITE } from '../config/site';

const title       = `Contact | ${SITE.orgName}`;
const description = 'Begin with a confidential inquiry. Share a brief description of the technology transformation, platform decision or advisory need you are evaluating.';
---

<Base title={title} description={description} canonicalPath="/contact" currentPath="/contact">

  <!-- Hero -->
  <section class="section section--ivory" aria-labelledby="contact-hero-heading">
    <div class="container contact-hero">
      <SectionLabel>Contact</SectionLabel>
      <h1 id="contact-hero-heading">Begin with the decision that needs clarity.</h1>
      <p class="contact-hero__body">
        If you are evaluating a technology transformation, critical platform, AI or data strategy,
        engineering operating model or resilience concern, share a brief description of the situation.
      </p>
      <p class="contact-hero__body">
        Qualified inquiries will receive a personal response.
      </p>
    </div>
  </section>

  <!-- Reasons to connect -->
  <section class="section section--paper" aria-labelledby="reasons-heading">
    <div class="container">
      <SectionLabel>Reasons to Connect</SectionLabel>
      <h2 id="reasons-heading">When a conversation with Arun may be appropriate.</h2>
      <div class="reasons-grid">
        {[
          {
            label: 'Executive Technology Advisory',
            copy:  'For senior leaders seeking an independent perspective on technology strategy, transformation priorities or a consequential decision.',
          },
          {
            label: 'Strategic Assessment',
            copy:  'For organizations requiring a focused review of a critical platform, transformation program, operating model, AI opportunity, data strategy or technology risk.',
          },
          {
            label: 'Capital Markets Technology',
            copy:  'For leaders evaluating platform modernization, architecture, data, resilience, vendor strategy or transformation sequencing within capital markets.',
          },
          {
            label: 'Board or Due Diligence Conversation',
            copy:  'For boards, private equity teams and portfolio company leaders seeking relevant technology perspective.',
          },
          {
            label: 'Consulting Partnership',
            copy:  'For consulting firms requiring senior financial services, capital markets or enterprise technology expertise.',
          },
          {
            label: 'Expert Consultation',
            copy:  'For qualified expert networks and research organizations seeking an independent consultation within Arun\'s areas of experience.',
          },
        ].map((r) => (
          <div class="reason-item">
            <h3 class="reason-item__label">{r.label}</h3>
            <p class="reason-item__copy">{r.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inquiry form -->
  <section class="section section--stone" aria-labelledby="form-heading">
    <div class="container form-container">
      <h2 id="form-heading">Discuss an Advisory Need</h2>
      <InquiryForm />
    </div>
  </section>

  <!-- Expert networks -->
  <section class="section section--paper" aria-labelledby="expert-heading">
    <div class="container expert">
      <SectionLabel>Expert Networks</SectionLabel>
      <h2 id="expert-heading">Connect about an expert consultation.</h2>
      <p>
        Arun participates selectively in expert consultations concerning financial services
        technology, capital markets platforms, engineering organizations, AI and data
        transformation, cloud strategy, outsourcing, vendor ecosystems and operational resilience.
      </p>
      <p>
        All consultations remain subject to applicable confidentiality, employment, conflict of
        interest and compliance obligations. Arun does not provide confidential, proprietary,
        client restricted or material nonpublic information.
      </p>
      <p class="expert__cta-note">
        Select <strong>Expert Consultation</strong> in the inquiry form above to begin the process.
      </p>
    </div>
  </section>

  <!-- LinkedIn -->
  <section class="section section--stone" aria-labelledby="contact-linkedin-heading">
    <div class="container contact-linkedin">
      <h2 id="contact-linkedin-heading">Connect with Arun on LinkedIn.</h2>
      <p>View Arun's professional background, perspectives and published updates.</p>
      <ExternalLink href={SITE.linkedInUrl} class="btn btn--secondary">
        View Arun on LinkedIn
        <span class="sr-only"> (opens LinkedIn profile)</span>
      </ExternalLink>
    </div>
  </section>

  <!-- Location -->
  <section class="section section--paper" aria-labelledby="contact-location-heading">
    <div class="container contact-location">
      <h2 id="contact-location-heading">New York Metropolitan Area</h2>
      <p>
        Available for select conversations with organizations across the United States and
        globally, subject to professional, confidentiality and compliance obligations.
      </p>
    </div>
  </section>

  <!-- Privacy notice -->
  <section class="section section--ivory" aria-label="Privacy notice">
    <div class="container privacy-notice">
      <p class="privacy-notice__text">
        Information submitted through this form will be used only to review and respond to your
        inquiry, subject to the website's
        <a href="/privacy">Privacy Notice</a>. Please do not submit sensitive personal information
        or confidential business information.
      </p>
    </div>
  </section>

</Base>

<style>
  /* Hero */
  .contact-hero {
    max-width: 720px;
    padding-block: var(--sp-9) var(--sp-10);
  }

  .contact-hero h1 {
    margin-block: var(--sp-4) var(--sp-6);
  }

  .contact-hero__body {
    font-size: var(--text-xl);
    margin-bottom: var(--sp-5);
  }

  /* Reasons */
  .reasons-grid {
    margin-top: var(--sp-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 768px) {
    .reasons-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .reason-item {
    padding: var(--sp-6) 0;
    border-top: var(--border-hairline);
  }

  .reason-item__label {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink-navy);
    margin-bottom: var(--sp-3);
  }

  .reason-item__copy {
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  /* Form section */
  .form-container {
    max-width: 800px;
  }

  .form-container h2 {
    margin-bottom: var(--sp-4);
  }

  /* Expert networks */
  .expert {
    max-width: var(--reading-width);
  }

  .expert h2 {
    margin-block: var(--sp-4) var(--sp-6);
  }

  .expert p {
    margin-bottom: var(--sp-5);
  }

  .expert__cta-note {
    padding: var(--sp-5) var(--sp-6);
    background-color: var(--color-soft-stone);
    border-left: 3px solid var(--color-muted-bronze);
    font-size: var(--text-sm);
    color: var(--color-charcoal);
  }

  /* LinkedIn */
  .contact-linkedin {
    max-width: 480px;
  }

  .contact-linkedin h2 {
    margin-bottom: var(--sp-4);
  }

  .contact-linkedin p {
    margin-bottom: var(--sp-6);
  }

  /* Location */
  .contact-location {
    max-width: 560px;
  }

  .contact-location h2 {
    margin-bottom: var(--sp-4);
  }

  /* Privacy notice */
  .privacy-notice {
    max-width: var(--reading-width);
    padding-block: var(--sp-6);
  }

  .privacy-notice__text {
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  .privacy-notice__text a {
    color: var(--color-slate-blue);
    text-decoration: underline;
  }
</style>

---
// Button.astro — renders as <a> when href is provided, <button> otherwise.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
  external?: boolean;
  disabled?: boolean;
  'aria-label'?: string;
  'aria-disabled'?: boolean;
  id?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  external = false,
  disabled = false,
  'aria-label': ariaLabel,
  'aria-disabled': ariaDisabled,
  id,
} = Astro.props;

const classes = ['btn', `btn--${variant}`, className].filter(Boolean).join(' ');
const externalAttrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    id={id}
    {...externalAttrs}
  >
    <slot />
    {external && (
      <span class="sr-only"> (opens in new tab)</span>
    )}
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled}
    aria-disabled={ariaDisabled}
    aria-label={ariaLabel}
    id={id}
  >
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-6);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      opacity var(--transition-fast);
    white-space: nowrap;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-slate-blue);
    outline-offset: 3px;
  }

  /* Primary — ink navy bg, ivory text */
  .btn--primary {
    background-color: var(--color-ink-navy);
    color: var(--color-warm-ivory);
    border-color: var(--color-ink-navy);
  }

  .btn--primary:hover {
    background-color: var(--color-deep-navy);
    border-color: var(--color-deep-navy);
  }

  /* Secondary — transparent, navy border */
  .btn--secondary {
    background-color: transparent;
    color: var(--color-ink-navy);
    border-color: var(--color-ink-navy);
  }

  .btn--secondary:hover {
    background-color: var(--color-ink-navy);
    color: var(--color-warm-ivory);
  }

  /* Ghost — text only, no border */
  .btn--ghost {
    background-color: transparent;
    color: var(--color-slate-blue);
    border-color: transparent;
    padding-inline: 0;
  }

  .btn--ghost:hover {
    color: var(--color-ink-navy);
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }
</style>

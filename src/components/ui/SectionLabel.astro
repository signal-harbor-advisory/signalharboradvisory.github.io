---
// SectionLabel.astro — small uppercase label above section headings
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<p class={['section-label', className].filter(Boolean).join(' ')}><slot /></p>

<style>
  .section-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-muted-bronze);
    margin-bottom: var(--sp-4);
    max-width: none;
  }
</style>

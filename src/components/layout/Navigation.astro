---
// Navigation.astro
// Desktop: wordmark left, nav links + LinkedIn + primary CTA right.
// Mobile:  wordmark + hamburger; full-height drawer with focus trap.
// Sticky behavior via IntersectionObserver on a sentinel div (no scroll listener).
import { SITE, hasLinkedIn } from '../../config/site';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/advisory',    label: 'Advisory'    },
  { href: '/experience',  label: 'Experience'  },
  { href: '/about',       label: 'About'       },
  { href: '/insights',    label: 'Insights'    },
];

const isLinkedInPlaceholder = !hasLinkedIn;

function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- Sentinel for IntersectionObserver sticky trigger -->
<div id="nav-sentinel" aria-hidden="true"></div>

<header id="site-header" role="banner">
  <nav class="nav-inner container" aria-label="Main navigation">

    <!-- Wordmark -->
    <a href="/" class="wordmark" aria-label="Signal Harbor Advisory — home">
      <span class="wordmark__name">SIGNAL HARBOR ADVISORY</span>
      <span class="wordmark__descriptor">Arun Arunachalam</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-link"
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}

      <!-- LinkedIn (desktop) -->
      <li class="nav-linkedin">
        <a
          href={isLinkedInPlaceholder ? '#' : SITE.linkedInUrl}
          class="nav-linkedin-link"
          target={isLinkedInPlaceholder ? undefined : '_blank'}
          rel={isLinkedInPlaceholder ? undefined : 'noopener noreferrer'}
          aria-label="LinkedIn profile (opens in new tab)"
          data-placeholder={isLinkedInPlaceholder ? 'true' : undefined}
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="sr-only">LinkedIn</span>
        </a>
      </li>
    </ul>

    <!-- Primary CTA -->
    <a href="/contact" class="nav-cta btn btn--primary">
      {SITE.primaryCta}
    </a>

    <!-- Mobile hamburger -->
    <button
      class="nav-hamburger"
      id="nav-hamburger"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Open navigation menu"
      type="button"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </nav>
</header>

<!-- Mobile drawer -->
<div
  id="nav-drawer"
  class="nav-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="nav-drawer__inner">
    <div class="nav-drawer__header">
      <span class="wordmark__name">SIGNAL HARBOR ADVISORY</span>
      <button
        class="nav-drawer__close"
        id="nav-drawer-close"
        aria-label="Close navigation menu"
        type="button"
      >
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4l12 12M16 4L4 16"/>
        </svg>
      </button>
    </div>

    <ul class="nav-drawer__links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-drawer__link"
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contact" class="nav-drawer__link">Contact</a>
      </li>
      <li>
        <a
          href={isLinkedInPlaceholder ? '#' : SITE.linkedInUrl}
          class="nav-drawer__link nav-drawer__link--linkedin"
          target={isLinkedInPlaceholder ? undefined : '_blank'}
          rel={isLinkedInPlaceholder ? undefined : 'noopener noreferrer'}
          data-placeholder={isLinkedInPlaceholder ? 'true' : undefined}
        >
          View Arun on LinkedIn
          {!isLinkedInPlaceholder && <span class="sr-only"> (opens in new tab)</span>}
        </a>
      </li>
    </ul>

    <div class="nav-drawer__cta">
      <a href="/contact" class="btn btn--primary">
        {SITE.primaryCta}
      </a>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="nav-overlay" class="nav-overlay" aria-hidden="true"></div>

<script src="../../scripts/nav.ts"></script>

<style>
  /* ── Header shell ──────────────────────────────────────────────────────── */
  #site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background-color: var(--color-warm-ivory);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  #site-header.is-stuck {
    border-bottom-color: var(--color-hairline);
    box-shadow: 0 1px 8px rgba(13, 27, 42, 0.06);
  }

  #nav-sentinel {
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }

  /* ── Nav inner ──────────────────────────────────────────────────────────── */
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: 72px;
  }

  /* ── Wordmark ──────────────────────────────────────────────────────────── */
  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark__name {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-navy);
    line-height: 1;
  }

  .wordmark__descriptor {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--color-slate);
    line-height: 1;
  }

  /* ── Desktop nav links ─────────────────────────────────────────────────── */
  .nav-links {
    display: none;
    align-items: center;
    gap: var(--sp-5);
    margin-left: auto;
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-charcoal);
    text-decoration: none;
    letter-spacing: var(--tracking-normal);
    padding-block: var(--sp-2);
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-ink-navy);
  }

  .nav-link[aria-current='page'] {
    color: var(--color-ink-navy);
    border-bottom-color: var(--color-muted-bronze);
  }

  /* LinkedIn icon button */
  .nav-linkedin-link {
    display: flex;
    align-items: center;
    color: var(--color-slate);
    padding: var(--sp-1);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .nav-linkedin-link:hover {
    color: var(--color-ink-navy);
  }

  /* CTA */
  .nav-cta {
    display: none;
    margin-left: var(--sp-4);
    font-size: var(--text-xs) !important;
    padding: var(--sp-2) var(--sp-5) !important;
  }

  @media (min-width: 1024px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  /* ── Hamburger ──────────────────────────────────────────────────────────── */
  .nav-hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--sp-2);
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .nav-hamburger:focus-visible {
    outline: 2px solid var(--color-slate-blue);
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .nav-hamburger {
      display: none;
    }
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-ink-navy);
    border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .nav-hamburger[aria-expanded='true'] .hamburger-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-hamburger[aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-hamburger[aria-expanded='true'] .hamburger-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ── Mobile drawer ──────────────────────────────────────────────────────── */
  .nav-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background-color: var(--color-paper);
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    overflow-y: auto;
  }

  .nav-drawer.is-open {
    transform: translateX(0);
  }

  .nav-drawer__inner {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding: var(--sp-5) var(--sp-5) var(--sp-8);
  }

  .nav-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-6);
    border-bottom: var(--border-hairline);
    margin-bottom: var(--sp-6);
  }

  .nav-drawer__close {
    color: var(--color-charcoal);
    padding: var(--sp-2);
    border-radius: var(--radius-sm);
    border: none;
    background: none;
    cursor: pointer;
  }

  .nav-drawer__close:focus-visible {
    outline: 2px solid var(--color-slate-blue);
    outline-offset: 3px;
  }

  .nav-drawer__links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .nav-drawer__link {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-charcoal);
    padding-block: var(--sp-4);
    border-bottom: var(--border-hairline);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-drawer__link:hover,
  .nav-drawer__link[aria-current='page'] {
    color: var(--color-ink-navy);
  }

  .nav-drawer__link--linkedin {
    font-size: var(--text-base);
    color: var(--color-slate-blue);
    font-weight: 400;
  }

  .nav-drawer__cta {
    margin-top: auto;
    padding-top: var(--sp-7);
  }

  .nav-drawer__cta .btn {
    width: 100%;
    justify-content: center;
  }

  /* ── Overlay ────────────────────────────────────────────────────────────── */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-overlay) - 1);
    background-color: rgba(13, 27, 42, 0.4);
  }

  .nav-overlay.is-visible {
    display: block;
  }
</style>

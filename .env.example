# ============================================================
# Environment variable reference for signalharboradvisory.com
#
# Copy this file to .env and fill in the values appropriate
# for your environment.
#
# Variables marked "NOT REQUIRED for local dev" can be left
# empty or omitted when running locally. The site and form
# will use simulation mode when these are absent.
#
# Variables marked "REQUIRED before launch" must be confirmed
# and configured before any public deployment.
# ============================================================

# ------------------------------------------------------------
# SITE URL
# Used by @astrojs/sitemap and canonical URL generation.
# NOT REQUIRED for local dev (astro.config.ts falls back to
# the DOMAIN_TBD placeholder which works for local builds).
# REQUIRED before launch — replace with confirmed domain.
# ------------------------------------------------------------
SITE_URL=https://DOMAIN_TBD

# ------------------------------------------------------------
# INQUIRY FORM — Resend email delivery
# Server-side only. Never expose RESEND_API_KEY to the client.
# NOT REQUIRED for local dev — form uses simulated submission.
# REQUIRED before launch.
# ------------------------------------------------------------
RESEND_API_KEY=

# Email address that receives submitted inquiries.
# REQUIRED before launch.
CONTACT_TO_EMAIL=

# From address used for inquiry notifications (must be a
# verified Resend sender domain).
# REQUIRED before launch.
CONTACT_FROM_EMAIL=

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE — bot protection for inquiry form
# NOT REQUIRED for local dev — Turnstile is disabled locally
# when TURNSTILE_SITE_KEY is empty.
# REQUIRED before launch.
# ------------------------------------------------------------

# Client-side site key (safe to expose in the browser).
PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secret key. Never expose to the client.
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# ANALYTICS
# NOT REQUIRED for local dev.
# REQUIRED before launch (confirm provider and key with Arun).
# ------------------------------------------------------------
PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------------
# NODE ENVIRONMENT
# Set to 'production' for production builds.
# Local dev uses 'development' automatically.
# ------------------------------------------------------------
NODE_ENV=development

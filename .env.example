# ============================================================
# Environment variable reference for signalharboradvisory.com
#
# Copy this file to .env and fill in the values appropriate
# for your environment.
#
# This is a fully static site (output: 'static') with no server-side
# code. The inquiry form posts directly to a separate Cloudflare
# Worker (https://signal-harbor-contact.asnarun75.workers.dev/submit,
# hardcoded in src/config/site.ts since it's a public, non-secret
# URL). Resend delivery, server-side validation, rate limiting and
# the Turnstile SECRET key all live inside that Worker's own
# environment — a different codebase/deployment — not here.
#
# The only environment variable this repository itself uses is the
# Turnstile PUBLIC site key below.
# ============================================================

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE — bot protection for the inquiry form
# Public site key only (safe to expose in the browser bundle —
# that's how Turnstile is designed to work). Never put the
# Turnstile SECRET key here or anywhere in this repository.
#
# NOT REQUIRED for local dev — when empty, the Turnstile widget
# simply isn't rendered and the token check is skipped.
# REQUIRED in production — set as a GitHub Actions repository
# variable (Settings → Secrets and variables → Actions → Variables),
# not committed here.
# ------------------------------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------
# ANALYTICS
# NOT REQUIRED for local dev.
# Pending analytics platform decision.
# ------------------------------------------------------------
PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------------
# NODE ENVIRONMENT
# Set to 'production' for production builds.
# Local dev uses 'development' automatically.
# ------------------------------------------------------------
NODE_ENV=development
